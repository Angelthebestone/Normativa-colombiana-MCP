{
  "name": "normativa-colombia-mcp",
  "version": "1.3.1",
  "description": "MCP para consultar la normativa y la jurisprudencia colombiana: Gestor Normativo de Función Pública, Corte Constitucional, Corte Suprema, SUIN-Juriscol (vigencia) y normograma de la DIAN",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/construir.ts",
    "generar-indice": "node scripts/generar-indice.ts",
    "generar-indice-suin": "node scripts/generar-indice-suin.ts",
    "test": "node --test test/smoke.ts",
    "pack": "npm run build && npx @anthropic-ai/mcpb pack . normativa-colombia.mcpb",
    "medir": "npm run build && node scripts/medir.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src scripts test",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:e2e",
    "test:e2e": "npm run build && node --test test/e2e.ts",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@types/node": "^26.1.2",
    "cheerio": "^1.0.0",
    "esbuild": "^0.28.1",
    "oxlint": "^1.76.0",
    "typescript": "^5.6.0",
    "zod": "^3.23.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Angelthebestone/Normativa-colombiana-MCP.git"
  },
  "homepage": "https://github.com/Angelthebestone/Normativa-colombiana-MCP",
  "bugs": {
    "url": "https://github.com/Angelthebestone/Normativa-colombiana-MCP/issues"
  },
  "author": "Angel Peña <adavidpena@uts.edu.co>",
  "bin": {
    "normativa-colombia-mcp": "server/index.js"
  },
  "files": [
    "server/",
    "datos/",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "colombia",
    "normativa",
    "jurisprudencia",
    "legaltech",
    "derecho",
    "dian",
    "vigencia",
    "tributario",
    "suin",
    "corte-suprema"
  ]
}
